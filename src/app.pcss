/* Write your global styles here, in PostCSS syntax */
:root {
	color-scheme: dark;
	--background: #0b0f14;
	--foreground: #141a23;
	--surface: #141a23;
	--surface-2: #1b2432;
	--surface-3: #222c3c;
	--border: rgba(148, 163, 184, 0.2);
	--text: #e5e7eb;
	--text-muted: #94a3b8;
	--text-strong: #f8fafc;
	--shadow-soft: 0 16px 40px rgba(2, 6, 23, 0.35);
	--radius-sm: 10px;
	--radius-md: 14px;
	--radius-lg: 20px;
	--red: #f87171;
	--green: #4ade80;
	--yellow: #facc15;
	--orange: #fb923c;
	--blue: #60a5fa;
	--brand: var(--blue);
}

* {
	box-sizing: border-box;
}

body {
	font-family: 'Inter', 'Segoe UI', system-ui, -apple-system, sans-serif;
	background: radial-gradient(circle at top, rgba(96, 165, 250, 0.08), transparent 60%),
		var(--background);
	color: var(--text);
	margin: 0;
	padding: 0;
	min-height: 100vh;
}

a {
	color: inherit;
	text-decoration: none;
}

img {
	max-width: 100%;
	display: block;
}

.desktop {
	min-height: 100vh;
	padding: 24px;
	display: flex;
	flex-direction: column;
	gap: 16px;
}

.button {
	display: inline-flex;
	align-items: center;
	justify-content: center;
	gap: 0.5rem;
	padding: 0.55rem 0.9rem;
	border-radius: var(--radius-sm);
	border: 1px solid var(--border);
	background: var(--surface-2);
	color: var(--text);
	font: inherit;
	font-weight: 500;
	letter-spacing: 0.01em;
	transition: transform 0.2s ease, background 0.2s ease, border-color 0.2s ease,
		box-shadow 0.2s ease;
}

.button:hover {
	cursor: pointer;
	background: var(--surface-3);
	border-color: rgba(148, 163, 184, 0.35);
	box-shadow: 0 8px 20px rgba(2, 6, 23, 0.3);
	transform: translateY(-1px);
}

.button:active {
	transform: translateY(0);
	box-shadow: none;
}

.button:disabled {
	opacity: 0.6;
	cursor: not-allowed;
}

.button--icon {
	width: 36px;
	height: 36px;
	padding: 0;
}

.button--primary {
	background: var(--brand);
	border-color: transparent;
	color: #0b0f14;
}

.button--primary:hover {
	background: color-mix(in srgb, var(--brand) 90%, white 10%);
}

.button--ghost {
	background: transparent;
	border-color: transparent;
	color: var(--text-muted);
}

.button--danger {
	background: rgba(248, 113, 113, 0.15);
	border-color: rgba(248, 113, 113, 0.4);
	color: var(--red);
}

.button--fab {
	width: 52px;
	height: 52px;
	border-radius: 999px;
	padding: 0;
	box-shadow: var(--shadow-soft);
}

.surface-card {
	background: var(--surface);
	border: 1px solid var(--border);
	border-radius: var(--radius-md);
	padding: 1rem;
	box-shadow: var(--shadow-soft);
}

input,
select,
textarea {
	font: inherit;
	color: var(--text);
}

input[type='text'],
input[type='password'],
select {
	width: 100%;
	padding: 0.65rem 0.75rem;
	border-radius: var(--radius-sm);
	border: 1px solid var(--border);
	background: var(--surface);
	color: var(--text);
	transition: border-color 0.2s ease, box-shadow 0.2s ease;
}

input[type='text']:focus,
input[type='password']:focus,
select:focus {
	outline: none;
	border-color: color-mix(in srgb, var(--brand) 75%, white 25%);
	box-shadow: 0 0 0 3px rgba(96, 165, 250, 0.2);
}

input[type='checkbox'],
input[type='range'] {
	accent-color: var(--brand);
}

@media (max-width: 768px) {
	.desktop {
		padding: 16px;
	}
}
